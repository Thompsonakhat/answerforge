# Telegram
TELEGRAM_BOT_TOKEN=

# MongoDB persistence. Optional at boot, but recommended for production memory, docs, feedback, and escalations.
MONGODB_URI=

# CookMyBots AI Gateway. Optional at boot; without it the bot uses retrieval-only fallback answers.
# COOKMYBOTS_AI_ENDPOINT is a BASE URL, for example https://api.cookmybots.com/api/ai
COOKMYBOTS_AI_ENDPOINT=
COOKMYBOTS_AI_KEY=
AI_TIMEOUT_MS=600000
AI_MAX_RETRIES=2
CONCURRENCY=20
AI_MODEL=

# Admin access. Comma-separated Telegram numeric user IDs.
ADMIN_USER_IDS=

# Support behavior
SUPPORT_CONFIDENCE_THRESHOLD=0.35
KNOWLEDGE_TOP_K=5
MAX_UPLOAD_BYTES=1048576
MAX_UPLOAD_CHARS=120000
GLOBAL_AI_CAP=1
RUNNER_CONCURRENCY=1
